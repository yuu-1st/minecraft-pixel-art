    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-standard": "^12.0.2",
    "typescript": "^5.2.2",
    "vite": "^6.4.2"
  },
